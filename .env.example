# Copy to .env. Values here are for running the backend on the host (outside Docker);
# docker-compose.yml overrides DATABASE_URL and OLLAMA_BASE_URL for the container.

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DB_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# FICTIONAL staff directory for the demo tool, a separate database on the same server (new_prd.md).
STAFF_DATABASE_URL=postgresql://rag:rag@localhost:5432/employee_demo

# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and Ollama only listens on
# IPv4, which adds ~2 s to every call (measured at M3: 2150 ms vs 75 ms per query embedding).
OLLAMA_BASE_URL=http://127.0.0.1:11434
FAST_MODEL=gemma4:e2b
ANSWER_MODEL=gemma4:e2b

# Tied: changing one means changing the other AND re-running ingestion (PRD 8.3).
EMBED_MODEL=gemma4:e2b
EMBED_DIM=1024
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT_S=120

# Retrieval: candidates from each search, and chunks passed to the answer model.
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_FINAL=5
RRF_K=60

# LLM: context window, per-call timeout, and total time allowed per question.
# Measured at M2 (RTX 3050 4 GB): first call ~41 s (models loading), then 7-16 s.
LLM_NUM_CTX=8192
LLM_CALL_TIMEOUT_S=90
QUESTION_BUDGET_S=300
MAX_RETRIES=2
MAX_SUB_QUERIES=3
WRITER_MAX_CHUNKS=10
HEALTH_TIMEOUT_S=3

# Offline rule: must stay false.
LANGCHAIN_TRACING_V2=false

