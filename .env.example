# Copy to .env. Values here are for running the backend on the host (outside Docker);
# docker-compose.yml overrides DATABASE_URL and OLLAMA_BASE_URL for the container.

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DB_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

OLLAMA_BASE_URL=http://localhost:11434
FAST_MODEL=gemma4:e2b
ANSWER_MODEL=gemma4:e2b

# Tied: changing one means changing the other AND re-running ingestion (PRD 8.3).
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

RRF_K=60
MAX_RETRIES=2
MAX_REGEN=1
HEALTH_TIMEOUT_S=3

# Offline rule: must stay false.
LANGCHAIN_TRACING_V2=false
